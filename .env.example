# ─────────────────────────────────────────────────────────────
# BEYOND — environment variables (copy to .env.local for local dev)
# ─────────────────────────────────────────────────────────────

# Public URL of the site — canonical URLs, Open Graph, sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.co.il

# Public contact details shown on the site (leave empty to hide them)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ── Contact form: where inquiries go (configure at least one) ──

# 1) Database (recommended) — any Postgres: Neon, Supabase, Railway…
#    The table is created automatically on the first inquiry.
DATABASE_URL=

# 2) Email notification via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "BEYOND <hello@your-domain.co.il>"
CONTACT_FROM_EMAIL=

# 3) Webhook (Make / Zapier / n8n / CRM) — receives each inquiry as JSON
CONTACT_WEBHOOK_URL=
# Optional: HMAC-SHA256 signature sent as "X-Beyond-Signature: sha256=<hex>"
CONTACT_WEBHOOK_SECRET=

# Salt for the one-way hash stored instead of the visitor IP (any random string)
IP_HASH_SALT=

# ── Leads inbox at /admin (Basic auth). Without a password /admin is disabled. ──
ADMIN_USER=admin
ADMIN_PASSWORD=
